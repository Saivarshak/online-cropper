# Disable directory browsing
Options -Indexes

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www (optional, remove if you want non-www)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Avoid 303 redirect loops for API calls
RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/upload$ [OR]
RewriteCond %{REQUEST_URI} ^/trim$ [OR]
RewriteCond %{REQUEST_URI} ^/download-url$
RewriteRule ^ - [L]

# Handle all other requests as normal
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
